# Copy to service/.env and fill in. Both come from https://my.telegram.org,
# under "API development tools". They belong to your Telegram account, not to
# the bot, so keep this file out of git: .gitignore already excludes it.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Only if you turn summaries on. From console.anthropic.com. Anything already
# in the environment wins over what is written here.
# ANTHROPIC_API_KEY=sk-ant-...
