#!/bin/bash
# Chute CLI. Wraps chute.py and whatever service manager this OS uses.
set -eu

# Follow symlinks back to the real script, so `chute` works when linked onto
# PATH (e.g. ~/.local/bin/chute -> /path/to/repo/chute).
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  LINKDIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$LINKDIR/$SOURCE" ;; esac
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SCRIPT="$HERE/chute.py"
LOG="$HERE/chute.log"
LABEL="chute"
PY="${CHUTE_PYTHON:-$(command -v python3 || true)}"

if [ -z "$PY" ]; then
  echo "Python 3 was not found on this computer, and Chute needs it." >&2
  echo "On a Mac it comes with the Xcode command line tools:  xcode-select --install" >&2
  echo "On Linux, install the python3 package." >&2
  exit 1
fi

# How to tell the user to invoke us: bare 'chute' only works once it is on PATH.
CLI="./chute"
command -v chute >/dev/null 2>&1 && CLI="chute"

# Does a config exist anywhere chute would look for one?
have_config() {
  [ -n "${CHUTE_CONFIG:-}" ] && [ -f "$CHUTE_CONFIG" ] && return 0
  [ -f "$HERE/config.json" ] && return 0
  [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/chute/config.json" ]
}

# Pid of a chute running in a terminal (fg), if any.
fg_pid() {
  [ -f "$HERE/chute.lock" ] || return 1
  LP="$(cat "$HERE/chute.lock" 2>/dev/null)"
  [ -n "$LP" ] && kill -0 "$LP" 2>/dev/null && echo "$LP"
}

OS="$(uname -s)"
case "$OS" in
  Darwin) UNIT="$HOME/Library/LaunchAgents/$LABEL.plist"
          TMPL="$HERE/service/launchd.plist.tmpl" ;;
  Linux)  UNIT="$HOME/.config/systemd/user/$LABEL.service"
          TMPL="$HERE/service/systemd.service.tmpl" ;;
  *)      UNIT=""; TMPL="" ;;
esac

render_unit() {
  [ -n "$TMPL" ] || { echo "No service template for $OS. Run './chute fg' under your own supervisor." >&2; exit 1; }
  mkdir -p "$(dirname "$UNIT")"
  sed -e "s|__PYTHON__|$PY|g" -e "s|__SCRIPT__|$SCRIPT|g" \
      -e "s|__DIR__|$HERE|g" -e "s|__LOG__|$LOG|g" \
      -e "s|__LABEL__|$LABEL|g" -e "s|__HOME__|$HOME|g" "$TMPL" > "$UNIT"
  echo "wrote $UNIT"
}

no_service() { echo "Background-service commands are not available on $OS. Run Chute in a terminal instead:  $CLI fg" >&2; exit 1; }

usage() {
  cat <<'CHUTE_HELP'
chute - send a file to a Telegram bot, it lands in the right folder

USAGE
  chute <command> [--config PATH]

FIRST RUN
  setup        Create the bot, pick a root folder, record your Telegram user id.
               Interactive. Writes config.json (chmod 600).
  check        Validate config, token and every destination folder.
  install      Start it now and at every login (launchd on macOS, systemd on
               Linux). Runs check first and refuses to install a broken config.

DAY TO DAY
  config       Folders and buttons, where files go, who may use the bot,
               and the token. A menu, not a text editor. Restart afterwards.
  status       Is it running? (default when no command is given)
  log          Follow the log. Ctrl-C to stop watching.
  restart      Pick up changes made with config, or edits to chute.py.
  start        Start the installed service.
  stop         Stop it. Telegram holds messages for 24h, so nothing is lost.

TROUBLESHOOTING
  fg           Run in this terminal instead of the background, printing
               everything. Stop the service first: chute stop
  test         Run the test suite. No network, no dependencies.
  version      Print the version.

REMOVING
  uninstall    Remove the service. Leaves config.json and your files alone.

OPTIONS
  --config PATH   Use a specific config file. Otherwise chute looks at
                  $CHUTE_CONFIG, then ./config.json, then
                  ${XDG_CONFIG_HOME:-~/.config}/chute/config.json

IN TELEGRAM
  /history     What was filed where, and when
  /help        Your folders, how names are made, and the limits

  Everything you send is filed on arrival. The buttons on each reply move
  that file to another folder, or delete it. A voice note, a media file or a
  YouTube link also gets a Transcribe button; see README.md.

Docs: README.md    Threat model: SECURITY.md
CHUTE_HELP
}

case "${1:-status}" in
  help|-h|--help) usage; exit 0 ;;
  setup)   exec "$PY" "$SCRIPT" setup "${@:2}" ;;
  check)   exec "$PY" "$SCRIPT" check "${@:2}" ;;
  config)  exec "$PY" "$SCRIPT" config "${@:2}" ;;
  fg|run)  exec "$PY" "$SCRIPT" run "${@:2}" ;;
  version) exec "$PY" "$SCRIPT" version ;;

  test)
    fail=0
    for t in "$HERE"/tests/test_*.py; do
      echo "== $(basename "$t")"
      "$PY" "$t" || fail=1
    done
    exit $fail ;;

  install)
    "$PY" "$SCRIPT" check
    render_unit
    case "$OS" in
      Darwin) launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
              launchctl bootstrap "gui/$UID" "$UNIT" ;;
      Linux)  systemctl --user daemon-reload
              systemctl --user enable --now "$LABEL" ;;
      *) no_service ;;
    esac
    echo
    echo "Chute is running, and from now on it starts on its own at every"
    echo "login. Nothing more to do."
    echo
    echo "Try it: send your bot a photo. Watch it arrive with:  $CLI log"
    echo "Check on it any time with:  $CLI status" ;;

  start)
    if [ ! -f "$UNIT" ]; then
      echo "Chute is not installed as a background service yet."
      echo "Install it with:  $CLI install"
      exit 1
    fi
    case "$OS" in
      Darwin) launchctl bootstrap "gui/$UID" "$UNIT" 2>/dev/null \
                && echo "Chute is running." \
                || echo "Chute was already running." ;;
      Linux)  systemctl --user start "$LABEL" && echo "Chute is running." ;;
      *) no_service ;;
    esac ;;

  stop)
    case "$OS" in
      Darwin)
        if launchctl bootout "gui/$UID/$LABEL" 2>/dev/null; then
          echo "Chute is stopped. Anything sent to the bot in the next 24 hours"
          echo "will be picked up when it starts again."
        elif PID="$(fg_pid)"; then
          echo "The background service is not running, but Chute is running in a"
          echo "terminal window (pid $PID). Press Ctrl-C in that window to stop it."
        else
          echo "Chute was not running."
        fi ;;
      Linux)  systemctl --user stop "$LABEL" 2>/dev/null && echo "Chute is stopped." \
                || echo "Chute was not running." ;;
      *) no_service ;;
    esac ;;

  restart)
    if [ ! -f "$UNIT" ]; then
      echo "Chute is not installed as a background service yet."
      echo "Install it with:  $CLI install"
      exit 1
    fi
    case "$OS" in
      Darwin) launchctl kickstart -k "gui/$UID/$LABEL" 2>/dev/null \
                || launchctl bootstrap "gui/$UID" "$UNIT" 2>/dev/null || true ;;
      Linux)  systemctl --user restart "$LABEL" ;;
      *) no_service ;;
    esac
    echo "Chute restarted with the current settings." ;;

  status)
    if ! have_config; then
      echo "Chute is not set up yet. Run:  $CLI setup"
      exit 0
    fi
    RUNNING=""
    case "$OS" in
      Darwin)
        if INFO="$(launchctl print "gui/$UID/$LABEL" 2>/dev/null)"; then
          PID="$(printf '%s\n' "$INFO" | awk '/^\tpid = /{print $3}')"
          if [ -n "$PID" ]; then
            echo "Chute is running (pid $PID)."
            RUNNING=1
          else
            echo "Chute is installed but not running right now."
            echo "Start it with:  $CLI start"
          fi
        elif PID="$(fg_pid)"; then
          echo "Chute is running in a terminal window (pid $PID)."
          RUNNING=1
        else
          echo "Chute is set up but not installed as a background service."
          echo "Install it with:  $CLI install   (or run it in this window:  $CLI fg)"
        fi ;;
      Linux)
        if systemctl --user --no-pager --quiet is-active "$LABEL" 2>/dev/null; then
          echo "Chute is running."
          RUNNING=1
        elif PID="$(fg_pid)"; then
          echo "Chute is running in a terminal window (pid $PID)."
          RUNNING=1
        else
          echo "Chute is not running. Install it with:  $CLI install"
        fi ;;
      *) no_service ;;
    esac
    # A running process never reloads its code or settings; the lock file's
    # age is the process start, so newer sources mean a stale bot.
    if [ -n "$RUNNING" ] && [ -f "$HERE/chute.lock" ]; then
      if [ "$HERE/chute.py" -nt "$HERE/chute.lock" ] \
         || { [ -f "$HERE/config.json" ] && [ "$HERE/config.json" -nt "$HERE/chute.lock" ]; }; then
        echo
        echo "Heads up: the code or settings changed after Chute started, so it"
        echo "is still running the old version. Pick up the changes with:"
        echo "    $CLI restart"
      fi
    fi
    if [ -f "$LOG" ]; then
      echo
      echo "Last few log lines:"
      tail -n 3 "$LOG" | sed 's/^/  /'
      [ -n "$RUNNING" ] || echo "  (follow the log any time with:  $CLI log)"
    fi ;;

  uninstall)
    case "$OS" in
      Darwin) launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true ;;
      Linux)  systemctl --user disable --now "$LABEL" 2>/dev/null || true ;;
    esac
    rm -f "$UNIT"
    echo "The background service is removed. Your settings and filed files are"
    echo "untouched; bring it back any time with:  $CLI install" ;;

  log)
    if [ ! -f "$LOG" ]; then
      echo "No log yet, Chute has not run on this computer."
      echo "Start it with:  $CLI install"
      exit 0
    fi
    echo "Following the log. Press Ctrl-C to stop watching (Chute keeps running)."
    echo
    tail -n 20 -f "$LOG" ;;

  *)
    echo "chute: unknown command '$1'" >&2
    echo >&2
    usage >&2
    exit 1 ;;
esac
